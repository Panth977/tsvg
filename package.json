{
  "name": "tsvg",
  "version": "0.10.0",
  "description": "TSVG \u2014 Timeseries Scalable Vector Graphics: a vector video format with real video controls, languages, audio mixes, themes and layouts.",
  "license": "MIT",
  "bin": {
    "tsvg": "cli/tsvg.mjs"
  },
  "files": [
    "web",
    "cli",
    "spec",
    "skills",
    "dist",
    "mod.ts",
    "README.md",
    "LICENSE",
    "libs",
    "editor"
  ],
  "scripts": {
    "test": "node tests/unit.mjs && node cli/tsvg.mjs test",
    "test:update": "node cli/tsvg.mjs test --update",
    "validate": "node cli/tsvg.mjs validate examples/demo/demo.tsvg",
    "pack": "node cli/tsvg.mjs pack examples/demo/demo.tsvg -o dist/demo.tsvgz",
    "playground": "node playground/build.mjs",
    "docs": "node cli/tsvg.mjs serve .",
    "build": "node scripts/build-dist.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.56.0"
  }
}