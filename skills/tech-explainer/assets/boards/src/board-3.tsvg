<?xml version="1.0" encoding="UTF-8"?>
<!-- Diagrams — a reference board for the tech-explainer skill: six original scenes in the tsvg:tech paper look.
     Isometric props are plain paths (X → down-right, Y → down-left, up = −y); flat content sits on a plane with
     rot="30" skx="-30" sy="0.866" (floor), sky="30" sx="0.866" (wall facing down-left) or sky="-30" sx="0.866" (facing down-right). -->
<tsvg version="0.10" title="Diagrams">
  <import src="tsvg:tech" as="tx"/>
  <import src="tsvg:icons" as="i"/>
  <layouts><layout id="portrait" w="1080" h="1920"/></layouts>
  <timeline>
    <tx:beat id="b1" chapter="Driver" say="Your printer only works / because of a small program / called a driver.">
      <tx:tile x="720" y="760" icon="printer" size="180" at="=cue('b1.0')" hl="=tx:on(cue('b1.0'), sdur)"/>
      <tx:wire d="M720 860 L720 950" at="=cue('b1.2')"/>
      <tx:pill x="720" y="1000" text="Driver" kind="gear" at="=cue('b1.2')"/>
    </tx:beat>

    <tx:beat id="b2" chapter="Chips" say="Most of an app runs / on the main processor, / but graphics and AI / get chips of their own.">
      <tx:wire d="M540 470 L220 640" at="=cue('b2.1') + 0.00" sw="3"/>
      <tx:wire d="M540 470 L330 760" at="=cue('b2.1') + 0.06" sw="3"/>
      <tx:wire d="M540 470 L460 820" at="=cue('b2.1') + 0.12" sw="3"/>
      <tx:wire d="M540 470 L620 820" at="=cue('b2.1') + 0.18" sw="3"/>
      <tx:wire d="M540 470 L750 760" at="=cue('b2.1') + 0.24" sw="3"/>
      <tx:wire d="M540 470 L860 640" at="=cue('b2.1') + 0.30" sw="3"/>
      <tx:wire d="M540 470 L880 500" at="=cue('b2.1') + 0.36" sw="3"/>
      <tx:tile x="540" y="470" icon="cpu" size="200" label="" at="=cue('b2.0')" hl="=tx:on(cue('b2.1'), cue('b2.2'))"/>
      <tx:tile x="220" y="640" icon="app-window" size="100" at="=cue('b2.0') + 0.20" op="=tx:fade(cue('b2.2'), sdur, 0.4)"/>
      <tx:tile x="330" y="760" icon="file-music" size="100" at="=cue('b2.0') + 0.28" op="=tx:fade(cue('b2.2'), sdur, 0.4)"/>
      <tx:tile x="460" y="820" icon="image" size="100" at="=cue('b2.0') + 0.36" op="=tx:fade(cue('b2.2'), sdur, 0.4)"/>
      <tx:tile x="620" y="820" icon="mail" size="100" at="=cue('b2.0') + 0.44" op="=tx:fade(cue('b2.2'), sdur, 0.4)"/>
      <tx:tile x="750" y="760" icon="calendar" size="100" at="=cue('b2.0') + 0.52" op="=tx:fade(cue('b2.2'), sdur, 0.4)"/>
      <tx:tile x="860" y="640" icon="gamepad-2" size="100" at="=cue('b2.0') + 0.60" op="=tx:fade(cue('b2.2'), sdur, 0.4)"/>
      <tx:tile x="880" y="500" icon="globe" size="100" at="=cue('b2.0') + 0.68" op="=tx:fade(cue('b2.2'), sdur, 0.4)"/>
