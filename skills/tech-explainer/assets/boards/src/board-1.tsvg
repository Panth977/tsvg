        <group x="-450.3" y="-70"><group sky="-30" sx="0.866"><rect w="320" h="40" fill="$shade" stroke="$line" sw="2"/></group></group></group></group>
      <tx:phone x="160" y="250" w="520" h="1080" tilt="-14" at="0.15"><rect w="492" h="1052" r="36" fill="$bg"/>
  <text x="34" y="80" size="22" weight="700" font="Outfit" fill="$ink" text="9:41"/>
  <text x="34" y="130" size="24" font="Outfit" fill="$muted" text="‹ Settings"/>
