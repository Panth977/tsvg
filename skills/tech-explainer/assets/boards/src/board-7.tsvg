        <path d="M-519.6 274 L0 574 L-207.8 694 L-727.4 394 Z" fill="$tile" stroke="$line" sw="2"/><path d="M-727.4 394 L-207.8 694 L-207.8 720 L-727.4 420 Z" fill="#efe9da" stroke="$line" sw="2"/><path d="M0 574 L-207.8 694 L-207.8 720 L0 600 Z" fill="#ddd6c3" stroke="$line" sw="2"/>
        <group x="-519.6" y="288"><group rot="30" skx="-30" sy="0.866"><rect repeat="60" as="k" x="=(k % 15)*38" y="=floor(k/15)*50 + 10" w="32" h="40" r="5" fill="$tile" stroke="$line" sw="1.5"/></group></group></group>
    </tx:beat>

    <tx:beat id="b5" chapter="Floating phone" say="Follow Your Channel, / and next time, / how your phone finds Wi-Fi.">
      <ellipse x="560" y="1220" rx="200" ry="30" fill="$shade" at="0.2"/>
      <group x="540" y="740"><group rot="-14" x="-200" y="-420"><tx:phone x="0" y="0" w="400" h="820" tilt="-10" at="0.1">
        <rect w="372" h="792" r="36" fill="$bg"/>
        <i:icon name="lock" size="26" color="$ink" x="186" y="90"/>
        <rect x="24" y="130" w="324" h="620" r="24" fill="$tile" stroke="$line" sw="2"/>
