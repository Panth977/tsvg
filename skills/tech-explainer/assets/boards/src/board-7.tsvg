<?xml version="1.0" encoding="UTF-8"?>
<!-- Endings — a reference board for the tech-explainer skill: six original scenes in the tsvg:tech paper look.
     Isometric props are plain paths (X → down-right, Y → down-left, up = −y); flat content sits on a plane with
     rot="30" skx="-30" sy="0.866" (floor), sky="30" sx="0.866" (wall facing down-left) or sky="-30" sx="0.866" (facing down-right). -->
<tsvg version="0.10" title="Endings">
  <import src="tsvg:tech" as="tx"/>
  <import src="tsvg:icons" as="i"/>
  <layouts><layout id="portrait" w="1080" h="1920"/></layouts>
  <timeline>
    <tx:follow id="b1" channel="Your Channel" say="Follow Your Channel, / and next time, / I'll show you where deleted files go."/>

    <tx:beat id="b2" chapter="Laptop" plate="1" say="Follow for more, / and next time, / we open up a power bank.">
      <group x="-60" y="960" scale="1.1">
        <group x="0" y="-720"><group sky="30" sx="0.866"><rect w="1100" h="720" r="30" fill="$tile" stroke="$ink" sw="4"/><rect x="26" y="26" w="1048" h="668" r="14" fill="$bg" stroke="$line" sw="2"/>
          <i:icon name="monitor" size="34" color="$ink" x="70" y="70"/><text x="100" y="70" size="30" weight="700" font="Outfit" fill="$ink" text="This laptop"/>
          <group x="120" y="130" at="0.1"><anim prop="opacity" from="0" to="1" dur="0.3"/>
            <rect y="8" w="820" h="440" r="18" fill="$shade"/><rect w="820" h="440" r="18" fill="$tile" stroke="$ink" sw="3"/>
            <group x="90" y="90" at="0.2"><anim prop="scale" from="0" to="1" dur="0.45" ease="back"/><circle r="56" fill="$green"/><i:icon name="sparkles" size="62" color="#ffffff" sw="2.2"/></group>
            <text x="170" y="90" size="50" weight="800" font="Outfit" fill="$ink" text="Your Channel"/>
            <rect x="40" y="180" w="740" h="44" r="10" fill="$green" at="=cue('b2.0')"><anim prop="w" from="0" to="740" dur="0.6" ease="out"/></rect>
            <group x="410" y="340" at="=cue('b2.1')"><anim prop="scale" from="0.6" to="1" dur="0.4" ease="back"/><anim prop="opacity" from="0" to="1" dur="0.2"/><rect x="-150" y="-40" w="300" h="80" r="17.6" fill="$green"/><text y="1" size="36" weight="700" font="Outfit" align="center" fill="#ffffff" text="+ Follow"/></group>
          </group></group></group>
        <path d="M0 0 L952.6 550 L294.4 930 L-658.2 380 Z" fill="$tile" stroke="$ink" sw="3"/><path d="M-658.2 380 L294.4 930 L294.4 964 L-658.2 414 Z" fill="#ece6d6" stroke="$ink" sw="3"/><path d="M952.6 550 L294.4 930 L294.4 964 L952.6 584 Z" fill="#ddd6c3" stroke="$ink" sw="3"/>
        <group x="-17.3" y="60"><group rot="30" skx="-30" sy="0.866"><rect repeat="70" as="k" x="=(k % 14)*71" y="=floor(k/14)*64" w="62" h="54" r="9" fill="$tile" stroke="$line" sw="2"/><rect x="320" y="370" w="360" h="300" r="16" fill="none" stroke="$line" sw="2.5"/></group></group></group>
    </tx:beat>

    <tx:beat id="b3" chapter="Phone page" cy="330" csize="46" say="Follow Your Channel, / and next time, / the trick inside a QR code.">
      <group at="0.05"><anim prop="opacity" from="0" to="1" dur="0.3"/><rect x="200" y="252" w="680" h="170" r="14" fill="$shade"/><rect x="200" y="244" w="680" h="170" r="14" fill="$tile" stroke="$ink" sw="3"/></group>
      <tx:phone x="400" y="520" w="290" h="600" tilt="0" at="0.2">
        <rect w="262" h="572" r="36" fill="$bg"/>
        <text x="24" y="80" size="22" font="Outfit" fill="$muted" text="‹"/>
        <group x="131" y="160" at="0.2"><anim prop="scale" from="0" to="1" dur="0.45" ease="back"/><circle r="52" fill="$green"/><i:icon name="sparkles" size="57" color="#ffffff" sw="2.2"/></group>
        <text x="131" y="250" size="28" weight="800" font="Outfit" align="center" fill="$ink" text="Your Channel"/>
        <group x="131" y="310" at="=cue('b3.1')"><anim prop="scale" from="0.6" to="1" dur="0.4" ease="back"/><anim prop="opacity" from="0" to="1" dur="0.2"/><rect x="-85" y="-26" w="170" h="52" r="11.44" fill="$green"/><text y="1" size="24" weight="700" font="Outfit" align="center" fill="#ffffff" text="+ Follow"/></group>
        <rect x="12" y="380" w="76" h="110" fill="$lime" stroke="$line" sw="1.5"/><rect x="93" y="380" w="76" h="110" fill="$green" stroke="$line" sw="1.5"/><rect x="174" y="380" w="76" h="110" fill="$pale" stroke="$line" sw="1.5"/>
        <i:icon name="qr-code" size="40" color="$ink" x="50" y="435"/><i:icon name="globe" size="40" color="#ffffff" x="131" y="435"/><i:icon name="battery" size="40" color="$ink" x="212" y="435"/>
      </tx:phone>
      <ellipse x="545" y="1150" rx="150" ry="22" fill="$shade" at="0.2"/>
    </tx:beat>

