        <rect x="640" y="460" w="18" h="18" fill="$green" stroke="$ink" sw="2" when="=T - T0 &gt; 0.3"/><rect x="680" y="550" w="18" h="18" fill="$green" stroke="$ink" sw="2" when="=T - T0 &gt; 0.5"/><rect x="720" y="640" w="18" h="18" fill="$green" stroke="$ink" sw="2" when="=T - T0 &gt; 0.7"/><rect x="760" y="730" w="18" h="18" fill="$green" stroke="$ink" sw="2" when="=T - T0 &gt; 0.9"/><rect x="800" y="820" w="18" h="18" fill="$green" stroke="$ink" sw="2" when="=T - T0 &gt; 1.1"/>
