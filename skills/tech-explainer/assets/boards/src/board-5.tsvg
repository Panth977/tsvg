<?xml version="1.0" encoding="UTF-8"?>
<!-- Numbers and scale — a reference board for the tech-explainer skill: six original scenes in the tsvg:tech paper look.
     Isometric props are plain paths (X → down-right, Y → down-left, up = −y); flat content sits on a plane with
     rot="30" skx="-30" sy="0.866" (floor), sky="30" sx="0.866" (wall facing down-left) or sky="-30" sx="0.866" (facing down-right). -->
<tsvg version="0.10" title="Numbers and scale">
  <import src="tsvg:tech" as="tx"/>
  <import src="tsvg:icons" as="i"/>
  <layouts><layout id="portrait" w="1080" h="1920"/></layouts>
  <timeline>
    <tx:beat id="b1" chapter="Refresh" say="Your screen redraws itself / 120 times a second.">
      <group x="540" y="640">
        <group at="0.1"><anim prop="opacity" from="0" to="1" dur="0.3"/><group><anim prop="y" from="-40" to="0" dur="0.45" ease="out"/><path d="M0 -16 L450.3 244 L103.9 444 L-346.4 184 Z" fill="$tile" stroke="$line" sw="2"/><path d="M-346.4 184 L103.9 444 L103.9 460 L-346.4 200 Z" fill="#efe9da" stroke="$line" sw="2"/><path d="M450.3 244 L103.9 444 L103.9 460 L450.3 260 Z" fill="#ddd6c3" stroke="$line" sw="2"/><group x="0" y="-16"><group rot="30" skx="-30" sy="0.866"><rect repeat="14" as="k" x="=30 + k*34" y="372" w="18" h="10" fill="$shade"/></group></group><path d="M0 32 L60.6 67 L17.3 92 L-43.3 57 Z" fill="$tile" stroke="$line" sw="1.5"/><path d="M-43.3 57 L17.3 92 L17.3 104 L-43.3 69 Z" fill="#efe9da" stroke="$line" sw="1.5"/><path d="M60.6 67 L17.3 92 L17.3 104 L60.6 79 Z" fill="#ddd6c3" stroke="$line" sw="1.5"/><path d="M277.1 192 L329.1 222 L277.1 252 L225.2 222 Z" fill="$tile" stroke="$line" sw="1.5"/><path d="M225.2 222 L277.1 252 L277.1 264 L225.2 234 Z" fill="#efe9da" stroke="$line" sw="1.5"/><path d="M329.1 222 L277.1 252 L277.1 264 L329.1 234 Z" fill="#ddd6c3" stroke="$line" sw="1.5"/><path d="M-190.5 142 L-121.2 182 L-164.5 207 L-233.8 167 Z" fill="$tile" stroke="$line" sw="1.5"/><path d="M-233.8 167 L-164.5 207 L-164.5 219 L-233.8 179 Z" fill="#efe9da" stroke="$line" sw="1.5"/><path d="M-121.2 182 L-164.5 207 L-164.5 219 L-121.2 194 Z" fill="#ddd6c3" stroke="$line" sw="1.5"/><path d="M95.3 317 L138.6 342 L103.9 362 L60.6 337 Z" fill="$tile" stroke="$line" sw="1.5"/><path d="M60.6 337 L103.9 362 L103.9 374 L60.6 349 Z" fill="#efe9da" stroke="$line" sw="1.5"/><path d="M138.6 342 L103.9 362 L103.9 374 L138.6 354 Z" fill="#ddd6c3" stroke="$line" sw="1.5"/><path d="M155.9 102 L233.8 147 L207.8 162 L129.9 117 Z" fill="$tile" stroke="$line" sw="1.5"/><path d="M129.9 117 L207.8 162 L207.8 174 L129.9 129 Z" fill="#efe9da" stroke="$line" sw="1.5"/><path d="M233.8 147 L207.8 162 L207.8 174 L233.8 159 Z" fill="#ddd6c3" stroke="$line" sw="1.5"/><path d="M52 128 L164.5 193 L52 258 L-60.6 193 Z" fill="$pale" stroke="$line" sw="2"/><path d="M-60.6 193 L52 258 L52 284 L-60.6 219 Z" fill="$mid" stroke="$line" sw="2"/><path d="M164.5 193 L52 258 L52 284 L164.5 219 Z" fill="$deep" stroke="$line" sw="2"/><group x="52" y="148"><group rot="30" skx="-30" sy="0.866"><rect w="90" h="90" r="6" fill="$deep"/><rect x="20" y="20" w="50" h="50" fill="$green"/></group></group></group></group>
        <line x1="52" y1="193" x2="52" y2="-65" stroke="$ink" sw="2.5" dash="6 6" at="=cue('b1.1')"/>
        <group at="=cue('b1.0') + 0.3"><anim prop="opacity" from="0" to="1" dur="0.3"/><group><anim prop="y" from="-40" to="0" dur="0.45" ease="out"/><group y="=-20*tx:grow(cue('b1.1'), 0.8)"><path d="M0 -220 L329.1 -30 L103.9 100 L-225.2 -90 Z" fill="$tile" stroke="$green" sw="3"/><path d="M-225.2 -90 L103.9 100 L103.9 110 L-225.2 -80 Z" fill="$pale" stroke="$green" sw="3"/><path d="M329.1 -30 L103.9 100 L103.9 110 L329.1 -20 Z" fill="$mid" stroke="$green" sw="3"/>
          <group x="0" y="-220"><group rot="30" skx="-30" sy="0.866"><rect x="20" y="20" w="230" h="110" r="10" fill="$pale"/><path d="M20 130 C 80 60 140 120 250 40 L250 130 Z" fill="$green"/><rect x="270" y="20" w="90" h="110" r="10" fill="$ink"/><circle x="315" y="75" r="18" fill="$tile"/><rect repeat="3" as="k" x="=20 + k*120" y="160" w="100" h="24" r="6" fill="$shade"/><rect x="20" y="200" w="160" h="24" r="6" fill="$deep"/></group></group></group></group></group></group>
      <tx:label x="540" y="300" text="120×" sub="a second · 8.3 ms each" size="56" tx="540" ty="520" at="=cue('b1.1')" hl="=tx:on(cue('b1.1'), sdur)"/>
    </tx:beat>

    <tx:beat id="b2" chapter="Photos per drive" say="A one terabyte drive / holds about 250,000 photos, / at 4 megabytes each.">
      <tx:label x="540" y="190" text="1,000,000,000,000 ÷ 4,000,000" mono="1" size="30" at="=cue('b2.1')"/>
      <group x="540" y="700" scale="0.92"><group at="=cue('b2.0')"><anim prop="opacity" from="0" to="1" dur="0.3"/><group><anim prop="y" from="-40" to="0" dur="0.45" ease="out"/><path d="M0 -460 L398.4 -230 L0 0 L-398.4 -230 Z" fill="$tile" stroke="$line" sw="2.5"/><path d="M-398.4 -230 L0 0 L0 460 L-398.4 230 Z" fill="#f3eee0" stroke="$line" sw="2.5"/><path d="M398.4 -230 L0 0 L0 460 L398.4 230 Z" fill="#e4ddc9" stroke="$line" sw="2.5"/>
        <group x="0" y="-460"><group rot="30" skx="-30" sy="0.866"><rect repeat="2116" as="k" x="=(k % 46)*10" y="=floor(k/46)*10" w="5" h="5" fill="$shade"/></group></group>
        <group x="-398.4" y="-230"><group sky="30" sx="0.866"><rect repeat="2116" as="k" x="=(k % 46)*10" y="=floor(k/46)*10" w="5" h="5" fill="$shade"/></group></group>
        <group x="0" y="0"><group sky="-30" sx="0.866"><rect repeat="2116" as="k" x="=(k % 46)*10" y="=floor(k/46)*10" w="5" h="5" fill="$shade"/></group></group>
        <group x="-398.4" y="120"><group sky="30" sx="0.866"><rect repeat="10" as="k" x="=k*46" y="0" w="46" h="110" fill="none" stroke="$line" sw="2"/></group></group>
        <group x="0" y="350"><group sky="-30" sx="0.866"><rect repeat="10" as="k" x="=k*46" y="0" w="46" h="110" fill="none" stroke="$line" sw="2"/></group></group>
        <path d="M-398.4 92 L-372.4 107 L-372.4 137 L-398.4 122 Z" fill="$green" stroke="$ink" sw="2"/></group></group></group>
      <tx:label x="380" y="1260" text="1 photo ≈ 4 MB" tx="186" ty="806" at="=cue('b2.2')" hl="=tx:on(cue('b2.2'), sdur)"/>
    </tx:beat>

    <tx:beat id="b3" chapter="Egress" say="Moving data out of a cloud / costs about 9 cents a gigabyte, / so a petabyte is about $90,000.">
      <group at="0" opacity="0.25"><anim prop="opacity" from="0" to="1" dur="0.35"/><group x="560" y="640" scale="0.9"><path d="M-251.1 -115 L-147.2 -55 L-147.2 5 L-251.1 -55 Z" fill="#efe9da" stroke="$line" sw="1.5"/><path d="M-69.3 -100 L-147.2 -55 L-147.2 5 L-69.3 -40 Z" fill="#ddd6c3" stroke="$line" sw="1.5"/><path d="M-69.3 -100 L-147.2 -55 L-108.2 -107.5 Z" fill="#ddd6c3" stroke="$line" sw="1.5"/><path d="M-173.2 -160 L-69.3 -100 L-108.2 -107.5 L-212.2 -167.5 Z" fill="#e6dfcc" stroke="$line" sw="1.5"/><path d="M-212.2 -167.5 L-108.2 -107.5 L-147.2 -55 L-251.1 -115 Z" fill="#e6dfcc" stroke="$line" sw="1.5"/><path d="M-230.4 -80.2 L-215.8 -71.8 L-215.8 -34.6 L-230.4 -43 Z" fill="$line" stroke="$line" sw="1"/><path d="M-199.2 -67 L-168 -49 L-168 -29.8 L-199.2 -47.8 Z" fill="$pale" stroke="$line" sw="1"/><path d="M138.6 -40 L242.5 20 L242.5 80 L138.6 20 Z" fill="#efe9da" stroke="$line" sw="1.5"/><path d="M320.4 -25 L242.5 20 L242.5 80 L320.4 35 Z" fill="#ddd6c3" stroke="$line" sw="1.5"/><path d="M320.4 -25 L242.5 20 L281.5 -32.5 Z" fill="#ddd6c3" stroke="$line" sw="1.5"/><path d="M216.5 -85 L320.4 -25 L281.5 -32.5 L177.5 -92.5 Z" fill="#e6dfcc" stroke="$line" sw="1.5"/><path d="M177.5 -92.5 L281.5 -32.5 L242.5 20 L138.6 -40 Z" fill="#e6dfcc" stroke="$line" sw="1.5"/><path d="M159.3 -5.2 L173.9 3.2 L173.9 40.4 L159.3 32 Z" fill="$line" stroke="$line" sw="1"/><path d="M190.5 8 L221.7 26 L221.7 45.2 L190.5 27.2 Z" fill="$pale" stroke="$line" sw="1"/><path d="M8.7 235 L112.6 295 L112.6 355 L8.7 295 Z" fill="#efe9da" stroke="$line" sw="1.5"/><path d="M190.5 250 L112.6 295 L112.6 355 L190.5 310 Z" fill="#ddd6c3" stroke="$line" sw="1.5"/><path d="M190.5 250 L112.6 295 L151.6 242.5 Z" fill="#ddd6c3" stroke="$line" sw="1.5"/><path d="M86.6 190 L190.5 250 L151.6 242.5 L47.6 182.5 Z" fill="#e6dfcc" stroke="$line" sw="1.5"/><path d="M47.6 182.5 L151.6 242.5 L112.6 295 L8.7 235 Z" fill="#e6dfcc" stroke="$line" sw="1.5"/><path d="M29.4 269.8 L44 278.2 L44 315.4 L29.4 307 Z" fill="$line" stroke="$line" sw="1"/><path d="M60.6 283 L91.8 301 L91.8 320.2 L60.6 302.2 Z" fill="$pale" stroke="$line" sw="1"/></group></group>
      <tx:tile x="540" y="320" icon="cloud" size="130" at="=cue('b3.0')"/>
      <group at="=cue('b3.1')">
        <group x="540" y="=min(420, 420 + (T - T0 - 0.00)*900)" when="=T - T0 &gt; 0.00"><circle r="24" fill="$lime" stroke="$ink" sw="3"/><circle r="15" fill="none" stroke="$green" sw="2"/><text y="2" size="20" weight="800" font="Outfit" align="center" fill="$green" text="$"/></group><group x="557" y="=min(478, 420 + (T - T0 - 0.12)*900)" when="=T - T0 &gt; 0.12"><circle r="24" fill="$lime" stroke="$ink" sw="3"/><circle r="15" fill="none" stroke="$green" sw="2"/><text y="2" size="20" weight="800" font="Outfit" align="center" fill="$green" text="$"/></group><group x="549" y="=min(536, 420 + (T - T0 - 0.24)*900)" when="=T - T0 &gt; 0.24"><circle r="24" fill="$lime" stroke="$ink" sw="3"/><circle r="15" fill="none" stroke="$green" sw="2"/><text y="2" size="20" weight="800" font="Outfit" align="center" fill="$green" text="$"/></group><group x="528" y="=min(594, 420 + (T - T0 - 0.36)*900)" when="=T - T0 &gt; 0.36"><circle r="24" fill="$lime" stroke="$ink" sw="3"/><circle r="15" fill="none" stroke="$green" sw="2"/><text y="2" size="20" weight="800" font="Outfit" align="center" fill="$green" text="$"/></group><group x="524" y="=min(652, 420 + (T - T0 - 0.48)*900)" when="=T - T0 &gt; 0.48"><circle r="24" fill="$lime" stroke="$ink" sw="3"/><circle r="15" fill="none" stroke="$green" sw="2"/><text y="2" size="20" weight="800" font="Outfit" align="center" fill="$green" text="$"/></group><group x="544" y="=min(710, 420 + (T - T0 - 0.60)*900)" when="=T - T0 &gt; 0.60"><circle r="24" fill="$lime" stroke="$ink" sw="3"/><circle r="15" fill="none" stroke="$green" sw="2"/><text y="2" size="20" weight="800" font="Outfit" align="center" fill="$green" text="$"/></group><group x="558" y="=min(768, 420 + (T - T0 - 0.72)*900)" when="=T - T0 &gt; 0.72"><circle r="24" fill="$lime" stroke="$ink" sw="3"/><circle r="15" fill="none" stroke="$green" sw="2"/><text y="2" size="20" weight="800" font="Outfit" align="center" fill="$green" text="$"/></group><group x="546" y="=min(826, 420 + (T - T0 - 0.