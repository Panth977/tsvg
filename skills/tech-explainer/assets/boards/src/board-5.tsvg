    <tx:beat id="b5" chapter="RAW vs JPEG" say="The RAW photo is 25 megabytes. / The JPEG is about 3, / around eight times smaller.">
      <group x="150" y="360" at="=cue('b5.0')"><anim prop="scale" from="0.85" to="1" dur="0.3" ease="back"/><anim prop="opacity" from="0" to="1" dur="0.2"/>
        <rect y="10" w="300" h="360" r="4" fill="$shade"/><rect w="300" h="360" r="4" fill="$tile" stroke="$ink" sw="2.5"/><path x="256" d="M0 0 L44 44 L0 44 Z" fill="$shade" stroke="$ink" sw="2.5"/>
        <i:icon name="camera" size="90" color="$green" x="150" y="110"/>
        <text x="150" y="230" size="26" font="Outfit" align="center" fill="$muted" text="photo.raw"/>
        <text x="150" y="295" size="56" weight="800" font="Outfit" align="center" fill="$ink" text="25 MB"/>
        <rect w="300" h="360" r="4" fill="none" stroke="$focus" sw="6" opacity="=tx:on(cue('b5.0'), cue('b5.1'))"/></group>
      <group x="630" y="360" at="=cue('b5.1')"><anim prop="scale" from="0.85" to="1" dur="0.3" ease="back"/><anim prop="opacity" from="0" to="1" dur="0.2"/>
        <rect y="10" w="300" h="360" r="4" fill="$shade"/><rect w="300" h="360" r="4" fill="$tile" stroke="$ink" sw="2.5"/><path x="256" d="M0 0 L44 44 L0 44 Z" fill="$shade" stroke="$ink" sw="2.5"/>
        <i:icon name="image" size="90" color="$green" x="150" y="110"/>
        <text x="150" y="230" size="26" font="Outfit" align="center" fill="$muted" text="photo.jpg"/>
        <text x="150" y="295" size="56" weight="800" font="Outfit" align="center" fill="$ink" text="3 MB"/>
        <rect w="300" h="360" r="4" fill="none" stroke="$focus" sw="6" opacity="=tx:on(cue('b5.1'), cue('b5.2'))"/></group>
      <group at="=cue('b5.2')"><anim prop="opacity" from="0" to="1" dur="0.3"/>
        <i:icon name="camera" size="44" color="$ink" x="170" y="930"/><rect x="220" y="905" w="=700*tx:grow(cue('b5.2'), 0.8)" h="50" r="4" fill="$shade" stroke="$ink" sw="2"/>
        <i:icon name="image" size="44" color="$ink" x="170" y="1050"/><rect x="220" y="1025" w="84" h="50" r="4" fill="$green" stroke="$ink" sw="2"/>
        <text x="330" y="1051" size="34" weight="700" font="Outfit" fill="$ink" text="8× smaller"/>
      </group>
    </tx:beat>

